{
  "name": "profile-readme-preview",
  "private": true,
  "version": "1.0.0",
  "description": "Local tooling to lint and preview the GitHub profile README.",
  "type": "module",
  "scripts": {
    "lint": "markdownlint-cli2 ../../README.md",
    "preview": "node serve.mjs",
    "render": "node render.mjs ../../README.md"
  },
  "dependencies": {
    "marked": "18.0.14"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.3"
  }
}
